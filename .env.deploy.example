# Salin jadi .env.deploy lalu isi private key wallet yang akan jadi OWNER kontrak Aether.
# Hanya dibaca oleh `npm run deploy:aggregator`; Next.js tidak pernah memuat file ini.
DEPLOYER_PRIVATE_KEY=
# Untuk `npm run deploy:aggregator -- --verify-etherscan` (API key gratis: etherscan.io/myapikey).
ETHERSCAN_API_KEY=
