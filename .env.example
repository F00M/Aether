# --- Wallet -----------------------------------------------------------------
# Reown/WalletConnect project id. Injected wallets (MetaMask, Rabby) work
# without it; WalletConnect and mobile deep-linking need one.
# Free key: https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- RPC --------------------------------------------------------------------
# A quote fires hundreds of eth_calls, so a private endpoint matters, and a
# private endpoint means a key that must not reach the browser.
#
# SEPOLIA_RPC_URLS is server-only: comma-separate as many endpoints as you have
# and /api/rpc/<shard> maps each shard to one of them (failing over to the rest).
SEPOLIA_RPC_URLS=

# What the browser actually calls. Point these at the proxy above — one path per
# upstream — and the engine keeps sharding batches to dodge 429s without ever
# seeing a key. Public endpoints can be used directly here instead.
NEXT_PUBLIC_SEPOLIA_RPC_URL=/api/rpc/0
NEXT_PUBLIC_SEPOLIA_RPC_URLS=/api/rpc/0,/api/rpc/1,/api/rpc/2

# --- Aggregator -------------------------------------------------------------
# The Aether diamond (executes V2/V3/V4 legs). Falls back to the deployed
# default in src/swap/quoteConfig.js when unset.
NEXT_PUBLIC_AETHER_AGGREGATOR_ADDRESS=

# Direct-pool route processing (legType V3_POOL/V2_PAIR). On by default; set to
# 0 to force every leg through the Universal Router instead.
NEXT_PUBLIC_AETHER_DIRECT_POOL_LEGS=

# --- API keys (server-only) ---------------------------------------------------
# These are read ONLY by the proxies in src/app/api and never reach the browser.
# Don't prefix them with NEXT_PUBLIC_ — that would inline them into the client
# bundle for anyone to read.

# LI.FI: quotes are compared against Aether's split and executed when they pay
# more. Works without a key at a lower rate limit (75 vs 12,000 per 2h).
LIFI_API_KEY=
# Integrator string sent with each quote (shows up in LI.FI's analytics).
LIFI_INTEGRATOR=

# Uniswap Trading API: without a key the app still works; the "Uniswap API"
# route card simply stays hidden.
UNISWAP_API_KEY=
